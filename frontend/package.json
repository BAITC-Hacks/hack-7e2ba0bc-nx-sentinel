{
  "name": "nx-campaign-intelligence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/services/data.test.ts",
    "test:browser": "node scripts/check-ui.mjs",
