# Trusted project-local official environment factory: package.module:function
# See docs/api.md. Empty means pilots are unavailable; uploads still work.
NX_ENV_FACTORY=

# AI explanation provider:
#   hybrid = local Qwen first, OpenAI fallback
#   local  = local only
#   cloud  = OpenAI only
#   off    = deterministic explanations only
LLM_MODE=hybrid

# Local OpenAI-compatible server (llama.cpp / compatible).
# HTTP is accepted only for loopback hosts (127.0.0.1 / localhost / ::1).
LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
LOCAL_LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M
LOCAL_LLM_API_KEY=

# Optional cloud fallback. Never commit a real API key.
OPENAI_API_KEY="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"
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
